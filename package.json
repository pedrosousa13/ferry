{
  "name": "ferry",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "test:e2e": "playwright test",
    "screenshots": "node scripts/screenshots.mjs",
    "package": "npm run build && node scripts/zip-dist.mjs chrome ferry-chrome.zip && node scripts/zip-dist.mjs firefox ferry-firefox.zip",
    "source": "git archive --format=zip -o ferry-source.zip HEAD"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/chrome": "^0.2.2",
    "@types/node": "^26.1.1",
    "@types/webextension-polyfill": "^0.12.5",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "yazl": "^3.3.1"
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  },
  "engines": {
    "node": ">=20"
  }
}
